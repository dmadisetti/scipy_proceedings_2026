{"version":3,"kind":"Article","sha256":"261faeaf63d97ab227177881b1c91f3e1a928395f0277098c721bc0b0bf8d6c2","slug":"index","location":"/index.md","dependencies":[],"frontmatter":{"title":"Content-Addressed Caching for Reactive Notebooks","subtitle":"A System for Cell-Level Cache Reuse in marimo","venue":{"title":"SciPy 2026","url":"https://www.scipy2026.scipy.org/"},"authors":[{"nameParsed":{"literal":"Dylan Madisetti","given":"Dylan","family":"Madisetti"},"name":"Dylan Madisetti","orcid":"0000-0003-1269-4989","corresponding":true,"email":"dylan@marimo.io","affiliations":["marimo"],"id":"contributors-index-generated-uid-0"},{"nameParsed":{"literal":"Myles Scolnick","given":"Myles","family":"Scolnick"},"name":"Myles Scolnick","email":"myles@marimo.io","affiliations":["marimo"],"id":"contributors-index-generated-uid-1"},{"nameParsed":{"literal":"Akshay Agrawal","given":"Akshay","family":"Agrawal"},"name":"Akshay Agrawal","email":"akshay@marimo.io","affiliations":["marimo"],"id":"contributors-index-generated-uid-2"}],"affiliations":[{"id":"marimo","name":"marimo"}],"open_access":true,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true}},"downloads":[{"title":"Notebook source (main.md)","url":"/scipy_proceedings/build/main-8194ee4b0dd6dcc014690f1dd9cdedce.md","filename":"main.md","format":"md","static":true}],"thumbnail":"/scipy_proceedings/build/fig1_dispatch-62847f04d965f3e139f954fc2b208428.png","exports":[{"format":"md","filename":"index.md","url":"/scipy_proceedings/build/index-bd12f37474f53e10139d9ea910932970.md"}]},"mdast":{"type":"root","children":[{"type":"block","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"include","file":"_abstract.md","literal":false,"lang":"markdown","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"We describe a caching mechanism for resumable sessions in marimo, a reactive Python notebook.\nCache keys are derived recursively from the reactive DAG, content-addressing reference values and substituting parent-cell hashes where direct content addressing is not possible.\nThe recurrence forms a Merkle structure that an edit invalidates at the subtree granularity.\nCached values cross process and session boundaries through a lazy stub mechanism and participate in marimo’s static WASM/HTML export, so heavy computations and trained models can ship with a notebook to readers with a browser-embedded Python runtime.\nEmpirically the cache lookup is as fast or faster than representative baselines on microbenchmarks of variably sized payloads.\nHowever, unlike other mechanisms, marimo’s caching is native to the reactive notebook, adds little user-facing overhead in its utilization, and allows for cross platform reuse.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vxWQdGjSbB"}],"key":"Gw3RVHUbeQ"}],"key":"GicIGerlHw"}],"data":{"part":"abstract"},"key":"PA2fjIN7Oj"},{"type":"block","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"heading","depth":2,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Read it your way","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"enUwqEBksE"}],"identifier":"read-it-your-way","label":"Read it your way","html_id":"read-it-your-way","implicit":true,"key":"GT4kagYKDw"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":40,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"link","url":"/pape